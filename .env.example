# ---------------------------------------------------------------
# MECANO AI — variables d'environnement
# Copier ce fichier en .env.local. Ne JAMAIS committer de secrets.
# ---------------------------------------------------------------

# Mode démonstration : aucune dépendance externe (données locales, OBD simulé, IA locale/mock)
DEMO_MODE=true

# Supabase (utilisé lorsque DEMO_MODE=false)
# Variables publiques (exposées au navigateur) : uniquement l'URL et la clé anon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur UNIQUEMENT (jamais préfixée NEXT_PUBLIC_) : utilisée par /api/invite
SUPABASE_SERVICE_ROLE_KEY=

# IA locale Ollama (optionnel). Sans Ollama, le MockAIProvider prend le relais.
OLLAMA_BASE_URL=http://localhost:11434
# Laisser vide pour utiliser le premier modèle installé (ex. llama3.2, mistral, qwen2.5)
OLLAMA_MODEL=
