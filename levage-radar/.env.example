# ---------------------------------------------------------------------------
# LEVAGE RADAR — variables d'environnement (copier en .env.local ; ne JAMAIS committer de secrets)
# ---------------------------------------------------------------------------

# --- Base de données ---
# Production : PostgreSQL (Supabase, Neon, serveur dédié…). Vide = PGlite locale (développement uniquement).
DATABASE_URL=
# Dossier PGlite (développement). « memory » = base en mémoire (perdue à l'arrêt).
PGLITE_DIR=
# Taille du pool PostgreSQL ; mettre DATABASE_PREPARE=false derrière un pooler en mode transaction (ex. Supabase port 6543).
DATABASE_POOL_MAX=5
DATABASE_PREPARE=true

# --- Application ---
# URL publique (liens des e-mails). HTTPS obligatoire en production.
APP_URL=http://localhost:3000
# Protège la page /setup de première installation (recommandé en production).
SETUP_TOKEN=

# --- Collecte planifiée ---
# Secret (≥ 16 caractères) attendu par /api/cron/daily dans l'en-tête « Authorization: Bearer … ».
# Sur Vercel, la variable CRON_SECRET est envoyée automatiquement par Vercel Cron.
CRON_SECRET=
# Profondeur de la première collecte (jours) et nombre maximal de pages par requête.
COLLECT_LOOKBACK_DAYS=30
COLLECT_MAX_PAGES=5
# Adresse de contact incluse dans l'User-Agent des connecteurs (bonne pratique vis-à-vis des sources).
CONNECTOR_CONTACT_EMAIL=

# --- Sources ---
# Pays TED (codes ISO-3 séparés par des virgules). Vide = tous les pays.
TED_COUNTRIES=FRA
# Liste de champs TED (facultatif, avancé). Vide = liste par défaut.
TED_FIELDS=
# Points d'accès (facultatif, pour tests).
BOAMP_API_URL=
TED_API_URL=

# --- Messagerie (facultatif) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Assistant : modèle de langage FACULTATIF ---
# none (défaut, gratuit, réponses par règles) | ollama (local) | anthropic (externe, payant).
# Un service externe n'est utilisé que si l'administrateur l'autorise dans Paramètres.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Démonstration ---
# true = autorise l'espace de démonstration (données FICTIVES, jamais mélangées aux données réelles).
ENABLE_DEMO_DATA=false
