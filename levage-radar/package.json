{
  "name": "levage-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed-demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "collect": "tsx --conditions=react-server scripts/collect.ts",
    "connectors:check": "tsx --conditions=react-server scripts/check-connectors.ts",
    "daily": "tsx --conditions=react-server scripts/collect.ts --daily",
    "build:vercel": "npm run db:migrate && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "^0.5.9",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "^16.3.6",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
